---
// docs/src/components/CodeBlock.astro
export interface Props {
  code: string;
  lang?: string;
}

const { code, lang = "bash" } = Astro.props;
---

<div class="group relative my-4 rounded-xl border border-[#111C2D] bg-[#0D1525] overflow-hidden">
  {lang && <div class="absolute top-0 right-0 px-3 py-1 text-xs text-white/30 font-mono">{lang}</div>}
  <pre class="overflow-x-auto p-4 text-sm leading-relaxed"><code class={`language-${lang}`}>{code}</code></pre>
  <button class="copy-btn absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity rounded-lg border border-[#111C2D] bg-[#1a2538] px-2.5 py-1 text-xs text-white/60 hover:text-white" data-code={code}>
    Copiar
  </button>
</div>

<script>
  document.querySelectorAll(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      await navigator.clipboard.writeText(btn.getAttribute("data-code") || "");
      const orig = btn.textContent;
      btn.textContent = "✓ Copiado";
      setTimeout(() => (btn.textContent = orig), 1500);
    });
  });
</script>
