{
  "name": "comment-section",
  "version": "0.1.0",
  "description": "Web Component de sección de comentarios — dark theme, emoji reactions, responsive grid. Funciona en React, HTML, Next.js, Astro y cualquier framework.",
  "type": "module",
  "main": "dist/comment-section.umd.js",
  "module": "dist/comment-section.es.js",
  "exports": {
    ".": {
      "import": "./dist/comment-section.es.js",
      "require": "./dist/comment-section.umd.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "web-test-runner",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "timeago.js": "^4.0.2"
  },
  "devDependencies": {
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@lit-labs/testing": "^0.2.8",
    "@types/node": "^25.9.1",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "typescript": "^6.0.3",
    "vite": "^5.1.0"
  },
  "keywords": [
    "web-component",
    "comments",
    "lit",
    "custom-element",
    "ui",
    "dark-theme"
